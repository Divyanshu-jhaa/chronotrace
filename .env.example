# Copy to .env and fill in — do not commit real secrets
# Neo4j runs via docker-compose (neo4j:5-community, neo4j/password) — no env needed.
# Only user-updatable secret is listed; all other defaults come from
# chronotrace.yml (graph.uri, mcp.host/port, api host/port) and the
# SDK's MCP_HTTP_PATH="/mcp". Override via YAML, not env.
MODEL_API_KEY=
