# Copy to .env and fill in — do not commit real secrets
# MODEL_API_KEY is the only required secret; Neo4j defaults to docker-compose
# neo4j/password for zero-config local dev (override only for external Neo4j).
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_URI=bolt://localhost:7687

MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
MODEL_DEEP_NAME=muse-wonder-1.0

MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_SERVER_URL=http://mcp-server:8001/mcp

API_HOST=0.0.0.0
API_PORT=8000
