# Copy to .env and fill in — do not commit real secrets
# All secrets and per-env values are supplied via environment, never baked into image or Compose.

# Neo4j — driver vs browser split
# - Driver (Bolt, for code): inside Compose use bolt://neo4j:7687 (DNS), on host bolt://localhost:7687.
# - Browser (HTTP, for humans): inside Compose http://neo4j:7474, on host http://localhost:7474 — open this in browser to see graph.
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
# Optional: override driver URI when running outside Compose (host). Inside Compose, docker-compose.yml sets NEO4J_URI=bolt://neo4j:7687.
# NEO4J_URI is derived from chronotrace.yml graph.uri; env takes precedence. Do NOT use http:// for driver.
# Browser is always at http://localhost:7474 (host) / http://neo4j:7474 (inside) — no env needed, just open in browser.

# Model API — required for agent/chat. Never commit the real key.
MODEL_API_KEY=
# Optional: override default Meta Model API base URL (e.g., https://api.example.com/v1)
# MODEL_BASE_URL=https://api.meta.example/v1

# MCP
MCP_HOST=127.0.0.1
MCP_PORT=8001
# MCP_HTTP_PATH is /mcp from the SDK (do not override unless SDK changes)

# API
API_HOST=127.0.0.1
API_PORT=8000

# Hostname split — container vs host + browser
# - Driver: agent-api/mcp-server → bolt://neo4j:7687 (Compose DNS), host CLI → bolt://localhost:7687
# - Browser: open http://localhost:7474 in browser to see graph (Neo4j Browser). Inside Compose: http://neo4j:7474
# - API: host → http://localhost:8000, inside → http://agent-api:8000 (via Compose network)
# Do NOT set driver graph.uri to http:// — driver needs bolt://; browser is separate HTTP UI.
